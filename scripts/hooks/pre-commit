#!/bin/bash
# Pre-commit guard for WordMaster: public/js/main.js is tracked, but
# only as a compiled RELEASE build. A dev build (from
# `scripts/watch.sh watch app` or `scripts/watch.sh compile app`)
# must never be committed: it is unoptimised, several MB, and would
# replace the release artifact the repo ships.
#
# The hook runs automatically on `git commit` when core.hooksPath
# points at scripts/hooks (one-time setup, see README.md):
#   git config core.hooksPath scripts/hooks
# It only inspects the staged copy of public/js/main.js, so commits
# that don't touch it pass straight through.
#
# A staged main.js is rejected as a dev build when either check hits:
#   - it contains `var COMPILED = false;` (shadow-cljs dev output
#     sets COMPILED false and loads modules from /js/cljs-runtime/;
#     the release build has no such line), or
#   - it is larger than 3 MB (release is ~1.1 MB; dev builds
#     measured 5.3-7.6 MB).
#
# To commit a new release build instead, run:
#   scripts/watch.sh release app && git add public/js/main.js
# To drop an accidental dev build from the worktree:
#   git checkout -- public/js/main.js
# (Bypass with `git commit --no-verify` only if you mean it.)
set -eu

FILE="public/js/main.js"

# Nothing staged for main.js -> nothing to check.
# (No pipe here on purpose: `grep -q` on a piped command exits
# early and, under `pipefail`, would make the check unreliable.)
if [ -z "$(git diff --cached --name-only --diff-filter=ACM -- "$FILE")" ]; then
  exit 0
fi

# Inspect the staged copy, not the worktree file (they may differ).
# Write it to a temp file first: grepping a multi-MB blob through a
# pipe lets `grep -q` quit early, SIGPIPE the producer, and -- under
# pipefail -- report a false negative.
BLOB="$(git ls-files -s -- "$FILE" | awk '{print $2}')"
SIZE="$(git cat-file -s "$BLOB")"
TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT
git cat-file -p "$BLOB" > "$TMP"

IS_DEV=0
if grep -q "var COMPILED = false;" "$TMP"; then
  IS_DEV=1
  REASON="contains 'var COMPILED = false;' (shadow-cljs dev output)"
elif [ "$SIZE" -gt 3000000 ]; then
  IS_DEV=1
  REASON="is $SIZE bytes (release is ~1.1 MB; dev builds are 5+ MB)"
fi

if [ "$IS_DEV" -eq 1 ]; then
  echo "pre-commit: refusing to commit $FILE" >&2
  echo "  It looks like a DEV build: it $REASON." >&2
  echo "  $FILE is tracked only as a compiled release build." >&2
  echo "  To commit a new release build instead:" >&2
  echo "    scripts/watch.sh release app && git add $FILE" >&2
  echo "  To drop the dev build from the worktree:" >&2
  echo "    git checkout -- $FILE" >&2
  exit 1
fi

exit 0
